# Local Community Edition development environment
#
# Usage:
#   cp .env.dev.local.example .env.dev.local
#   # Edit .env.dev.local as needed
#   python run_local.py --community

# =============================================================================
# APPLICATION
# =============================================================================

SECRET_KEY=local-dev-secret-key-change-me
ENVIRONMENT=development
DEBUG=true
DECISION_RECORDS_EDITION=community

# Local SQLite is the default for CE development.
DATABASE_URL=sqlite:///instance/architecture_decisions_5002.db

# If you want to test against local PostgreSQL instead, start the repo's
# docker-compose postgres profile and use a URL like:
# DATABASE_URL=postgresql://postgres:changeme@localhost:5432/decisions

# Self-hosted/local development usually is not behind Cloudflare.
SKIP_CLOUDFLARE_CHECK=true

# =============================================================================
# WEBAUTHN
# =============================================================================

# WebAuthn requires a secure context (HTTPS or localhost).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Decision Records (Local Dev)
WEBAUTHN_ORIGIN=http://localhost:5002

# =============================================================================
# MASTER ACCOUNT
# =============================================================================

MASTER_USERNAME=admin
MASTER_PASSWORD=changeme

# =============================================================================
# OPTIONAL EMAIL
# =============================================================================

EMAIL_VERIFICATION_REQUIRED=false
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-app-password

# Additional SMTP settings can be configured from the admin UI.
